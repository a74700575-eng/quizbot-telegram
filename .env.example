# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-your-token-here
# أرقام حسابات الأدمن (اعرف رقمك من @userinfobot) مفصولة بفاصلة
ADMIN_IDS=111111111,222222222
# مكان قاعدة البيانات. على Railway/Render/Docker لازم يكون على Volume/Disk عشان البيانات ماتضيعش
DB_PATH=data/quizbot.db
# الأزرار الملونة (أزرق/أخضر/أحمر). اكتب 0 لو عايزها عادية
COLORED_BUTTONS=1
# توقيت العرض في السجل (اختياري)
TIMEZONE=Africa/Cairo
# استيراد الأسئلة بالذكاء الاصطناعي (اختياري، قد تنطبق رسوم مزود الخدمة)
# استخدم gemini للـ Google GenAI SDK الأصلي أو openai لمزود متوافق مع OpenAI
AI_PROVIDER=gemini
AI_API_KEY=
# مطلوب فقط إذا كان AI_PROVIDER=openai ومزودك له عنوان مخصص
AI_API_BASE=
AI_MODEL=gemini-3.1-flash-lite

# توكن البوت من @BotFather (لا تضع التوكن الحقيقي في GitHub)
BOT_TOKEN=123456:ABC-your-token-here
# أرقام حسابات الأدمن مفصولة بفاصلة
ADMIN_IDS=111111111,222222222
# Railway: أضف في Variables: DATABASE_URL=${{Postgres.DATABASE_URL}}
# غيّر Postgres لاسم خدمة قاعدة البيانات عندك. اترك DATABASE_URL غير مضبوط لاستخدام SQLite محليًا.
# DATABASE_URL=
# مسار قاعدة SQLite المحلي؛ عند ضبط DATABASE_URL يتم استخدام PostgreSQL بدلًا منه.
DB_PATH=data/quizbot.db
# استيراد الأسئلة بالذكاء الاصطناعي (اختياري، وقد تنطبق رسوم مزود الخدمة)
AI_PROVIDER=gemini
AI_API_KEY=
# مطلوب فقط إذا كان AI_PROVIDER=openai ومزودك له عنوان مخصص
AI_API_BASE=
AI_MODEL=gemini-3.1-flash-lite
# إعدادات اختيارية
TIMEZONE=Africa/Cairo
COLORED_BUTTONS=1
